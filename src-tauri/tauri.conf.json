{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Server Hub",
  "version": "0.2.0",
  "identifier": "app.oneclicktool.serverhub",
  "build": {
    "devUrl": "http://localhost:1450",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Server Hub", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 520, "titleBarStyle": "Overlay", "hiddenTitle": true }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Start and stop every local server from one window",
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
