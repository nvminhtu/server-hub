{
  "name": "server-hub",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bridge": "cargo run --quiet --manifest-path core/Cargo.toml --bin server-hub -- bridge",
    "build": "tsc --noEmit && vite build",
    "app": "tauri dev",
    "test": "cargo test --manifest-path core/Cargo.toml",
    "check": "npm run build && npm test",
    "bundle:mac": "tauri build --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
